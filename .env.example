# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.

PORT=5000
NODE_ENV=development

# Long random string used to sign the application JWT.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# From your GitHub OAuth App settings (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Must exactly match the "Authorization callback URL" set on the GitHub OAuth App.
# Locally:
GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback
# On Render, this becomes something like:
# GITHUB_CALLBACK_URL=https://ai-capsule.onrender.com/auth/github/callback

# Where the SQLite file lives. On Render's free tier this is on ephemeral disk.
DATABASE_PATH=./data.sqlite
